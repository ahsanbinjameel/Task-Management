{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=WorkflowApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Cors": { "Origins": [ "http://localhost:4200" ] },
  "Jwt": {
    "Issuer": "WorkflowApp",
    "Audience": "WorkflowApp",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "SigningKey": "REPLACE_WITH_ENV_SECRET_AT_LEAST_32_CHARS_LONG"
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinimumPasswordLength": 10,
    "DefaultAdminUserName": "admin",
    "DefaultAdminEmail": "admin@workflowapp.local",
    "DefaultAdminDisplayName": "System Administrator",
    "DefaultAdminPassword": "ChangeMe!2024"
  },
  "Workforce": {
    "TimeZoneId": "UTC",
    "MaxShiftHours": 16,
    "AutoCloseStaleShifts": true,
    "StaleShiftScanMinutes": 30
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": true
  },
  "Security": {
    "RequireHttps": true
  },
  "FileStorage": { "Root": "C:\\WorkflowApp\\storage" },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
